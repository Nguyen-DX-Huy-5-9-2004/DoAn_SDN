# ========================================================
# Configuration File Template - COPY TO .env AND EDIT
# ========================================================
# 
# HƯỚNG DẪN:
# 1. Copy file này thành .env:
#    cp .env.example .env
#
# 2. Sửa file .env với IP/hostname của bạn
#    nano .env
#
# 3. KHÔNG PUSH .env lên Git (đã thêm vào .gitignore)
#
# ========================================================

# Target IP Address (THAY ĐỔI CÁI NÀY)
TARGET_IP=10.0.0.1

# Target Port
TARGET_PORT=80

# Target Path
TARGET_PATH=/

# Target Hostname (dùng cho SNI - Server Name Indication)
TARGET_HOSTNAME=example.com

# Sử dụng SSL/TLS (True hoặc False)
USE_SSL=False

# Số connections tối đa
MAX_CONNECTIONS=5000

# Số kết nối đồng thời mở tại cùng một thời điểm
CONCURRENT_CONNECTIONS=100

# Thời gian attack (giây)
DURATION=60

# Tuning optional cho tanCong_ip_massive_v2.py
# REQUESTS_PER_CONN = số request gửi trên mỗi kết nối
REQUESTS_PER_CONN=1
# POST_CONTENT_LENGTH = tổng độ dài body POST
# Nếu bạn dùng DURATION lớn, nội dung body phải đủ nhiều để duy trì slow POST trong toàn bộ thời gian
POST_CONTENT_LENGTH=300000
# CHUNK_SIZE = kích thước mỗi lần gửi body
CHUNK_SIZE=1024
# CHUNK_INTERVAL = giãn cách (giây) giữa các chunk
# Giá trị càng lớn thì kết nối càng được giữ lâu, nhưng tốc độ gửi càng chậm
CHUNK_INTERVAL=1.0

# ========================================================
# VÍ DỤ CẤU HÌNH:
# ========================================================
#
# Ví dụ 1: HTTP Web Server
# TARGET_IP=192.168.1.100
# TARGET_PORT=80
# TARGET_PATH=/
# TARGET_HOSTNAME=example.com
# USE_SSL=False
# MAX_CONNECTIONS=5000
# DURATION=60
#
# Ví dụ 2: HTTPS Web Server
# TARGET_IP=101.96.125.179
# TARGET_PORT=443
# TARGET_PATH=/bang-tin.html
# TARGET_HOSTNAME=sinhvien.uneti.edu.vn
# USE_SSL=True
# MAX_CONNECTIONS=10000
# DURATION=300
## Nếu bạn không chắc port nào, hãy dùng 443 với USE_SSL=True,
# vì target của bạn trả về HTTPS trên port 443.
## Ví dụ 3: API Server
# TARGET_IP=10.0.0.50
# TARGET_PORT=8000
# TARGET_PATH=/api/users
# TARGET_HOSTNAME=api.example.com
# USE_SSL=True
# MAX_CONNECTIONS=2000
# DURATION=120
#
